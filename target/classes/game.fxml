<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controllers.GameController">

    <top>
        <VBox spacing="8" style="-fx-padding: 10 20 10 20; -fx-background-color: #ffffff;">
            <HBox alignment="CENTER_LEFT" spacing="25">
                <Label fx:id="scoreLabel" style="-fx-text-fill: #2e7d32; -fx-font-size: 20px; -fx-font-weight: bold; -fx-background-color: #e8f5e9; -fx-padding: 8 20; -fx-background-radius: 25; -fx-border-color: #4caf50; -fx-border-radius: 25; -fx-border-width: 2;" text="⭐ Оноо: 0" />
                <Label fx:id="rankLabel" style="-fx-text-fill: #e65100; -fx-font-size: 20px; -fx-font-weight: bold; -fx-background-color: #fff3e0; -fx-padding: 8 20; -fx-background-radius: 25; -fx-border-color: #ff9800; -fx-border-radius: 25; -fx-border-width: 2;" text="🏆 Ранк: 0" />
                <Label fx:id="kingLabel" style="-fx-text-fill: #1a237e; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-color: #e8eaf6; -fx-padding: 8 20; -fx-background-radius: 25; -fx-border-color: #3f51b5; -fx-border-radius: 25; -fx-border-width: 2;" text="👑 Таны зэрэглэл: ..." />
            </HBox>
            <HBox alignment="CENTER_RIGHT" spacing="12">
                <Button onAction="#logout" style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 6 20; -fx-background-radius: 20; -fx-cursor: hand;" text="🚪 Гарах" />
                <Button onAction="#openHelp" style="-fx-background-color: #1976d2; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 6 20; -fx-background-radius: 20; -fx-cursor: hand;" text="❓ Тусламж" />
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="15" style="-fx-padding: 10 0 10 0; -fx-background-color: #ffffff;">
            <Label style="-fx-text-fill: #2e7d32; -fx-font-size: 16px; -fx-font-weight: bold;" text="🎡 Хүрд эргүүлэн асуулт сонго" />
            <Canvas fx:id="wheelCanvas" height="280.0" width="280.0" />
        </VBox>
    </center>

    <bottom>
        <VBox spacing="12" alignment="CENTER" style="-fx-padding: 10 20 20 20; -fx-background-color: #f5f5f5;">
            
            <TextArea fx:id="questionArea" 
                      editable="false" 
                      wrapText="true" 
                      prefWidth="550" 
                      prefHeight="80"
                      style="-fx-background-color: #ffffff; 
                             -fx-text-fill: #1b5e20; 
                             -fx-font-size: 16px; 
                             -fx-font-weight: bold; 
                             -fx-padding: 15; 
                             -fx-border-color: #a5d6a7; 
                             -fx-border-radius: 12; 
                             -fx-background-radius: 12; 
                             -fx-border-width: 2;
                             -fx-control-inner-background: white;" 
                      text="🎯 Хүрд эргүүлээд асуулт сонгоно уу!" />

            <GridPane alignment="CENTER" hgap="20" vgap="12" style="-fx-padding: 5 0 5 0;">
                <children>
                    <Button fx:id="optionA" onAction="#handleAnswer" 
                            style="-fx-background-color: #c8e6c9; 
                                   -fx-text-fill: #1b5e20; 
                                   -fx-font-size: 16px; 
                                   -fx-font-weight: bold; 
                                   -fx-padding: 12 40; 
                                   -fx-background-radius: 12; 
                                   -fx-border-color: #388e3c; 
                                   -fx-border-radius: 12; 
                                   -fx-border-width: 2; 
                                   -fx-cursor: hand;" 
                            text="A. ..." GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    
                    <Button fx:id="optionB" onAction="#handleAnswer" 
                            style="-fx-background-color: #fff9c4; 
                                   -fx-text-fill: #f57f17; 
                                   -fx-font-size: 16px; 
                                   -fx-font-weight: bold; 
                                   -fx-padding: 12 40; 
                                   -fx-background-radius: 12; 
                                   -fx-border-color: #f9a825; 
                                   -fx-border-radius: 12; 
                                   -fx-border-width: 2; 
                                   -fx-cursor: hand;" 
                            text="B. ..." GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    
                    <Button fx:id="optionC" onAction="#handleAnswer" 
                            style="-fx-background-color: #b3e5fc; 
                                   -fx-text-fill: #01579b; 
                                   -fx-font-size: 16px; 
                                   -fx-font-weight: bold; 
                                   -fx-padding: 12 40; 
                                   -fx-background-radius: 12; 
                                   -fx-border-color: #0288d1; 
                                   -fx-border-radius: 12; 
                                   -fx-border-width: 2; 
                                   -fx-cursor: hand;" 
                            text="C. ..." GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    
                    <Button fx:id="optionD" onAction="#handleAnswer" 
                            style="-fx-background-color: #ffccbc; 
                                   -fx-text-fill: #bf360c; 
                                   -fx-font-size: 16px; 
                                   -fx-font-weight: bold; 
                                   -fx-padding: 12 40; 
                                   -fx-background-radius: 12; 
                                   -fx-border-color: #d84315; 
                                   -fx-border-radius: 12; 
                                   -fx-border-width: 2; 
                                   -fx-cursor: hand;" 
                            text="D. ..." GridPane.columnIndex="1" GridPane.rowIndex="1" />
                </children>
                <columnConstraints>
                    <ColumnConstraints />
                    <ColumnConstraints />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                </rowConstraints>
            </GridPane>

            <Button onAction="#spinWheel" 
                    style="-fx-background-color: linear-gradient(to right, #43a047, #2e7d32); 
                           -fx-text-fill: white; 
                           -fx-font-size: 20px; 
                           -fx-font-weight: bold; 
                           -fx-padding: 14 50; 
                           -fx-background-radius: 30; 
                           -fx-cursor: hand; 
                           -fx-effect: dropshadow(gaussian, rgba(46,125,50,0.5), 15, 0, 0, 4); 
                           -fx-border-color: #1b5e20; 
                           -fx-border-radius: 30; 
                           -fx-border-width: 1;" 
                    text="🎡 Хүрд эргүүлэх" />
        </VBox>
    </bottom>
</BorderPane>