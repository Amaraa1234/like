<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane styleClass="root" stylesheets="@css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controllers.LoginController">
    
    <VBox alignment="CENTER" 
          layoutX="0" 
          layoutY="0" 
          prefHeight="500.0" 
          prefWidth="600.0" 
          spacing="25" 
          styleClass="login-panel"
          AnchorPane.bottomAnchor="0" 
          AnchorPane.leftAnchor="0" 
          AnchorPane.rightAnchor="0" 
          AnchorPane.topAnchor="0">
        
        <!-- Гарчиг -->
        <Label styleClass="login-title" text="🎡 Тавтай морил" />
        
        <!-- Дэд гарчиг -->
        <Label styleClass="login-subtitle" text="Хүрдний тоглоомонд нэвтрэх" />
        
        <!-- Хэрэглэгчийн нэр -->
        <TextField fx:id="usernameField" 
                   promptText="👤 Хэрэглэгчийн нэр" 
                   styleClass="input-field" 
                   prefHeight="45" 
                   prefWidth="380" />
        
        <!-- Нууц үг -->
        <PasswordField fx:id="passwordField" 
                       promptText="🔒 Нууц үг" 
                       styleClass="input-field" 
                       prefHeight="45" 
                       prefWidth="380" />
        
        <!-- Алдааны мессеж -->
        <Label fx:id="messageLabel" styleClass="message-label" />
        
        <!-- Товчнууд -->
        <HBox alignment="CENTER" spacing="25" style="-fx-padding: 10 0 0 0;">
            <Button onAction="#handleLogin" styleClass="login-button" text="🔑 Нэвтрэх" />
            <Button onAction="#handleRegister" styleClass="register-button" text="📝 Бүртгүүлэх" />
        </HBox>
        
        <!-- Нэмэлт мэдээлэл -->
        <Label styleClass="footer-text" text="✨ Шинэ хэрэглэгч? Бүртгүүлээд тоглоомоо эхлүүлээрэй!" />
        
    </VBox>
</AnchorPane>